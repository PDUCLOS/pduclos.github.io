ometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="pas de lien sûr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#1B2A41;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;jettySize=auto;fontSize=16;fontColor=#26333F;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;br/&gt;&lt;b&gt;Référentiel des liens&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• tarif × référence ERP × entité&lt;br/&gt;• versionné, daté, signé&lt;br/&gt;• jamais effacé : une suppression&lt;br/&gt;  est un statut&lt;br/&gt;• toute opération annulable&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Mémorisé : au prochain tarif,&lt;/b&gt;&lt;br/&gt;&lt;b&gt;la même ligne passe en L0.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#2E8B6A;fontColor=#26333F;fontSize=18;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="130" width="360" height="480" as="geometry"/></mxCell><mxCell id="c11" value="lien retenu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2E8B6A;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.104;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;jettySize=auto;fontSize=16;fontColor=#26333F;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c10"><mxGeometry x="0" y="-14" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="lien retenu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2E8B6A;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.371;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;jettySize=auto;fontSize=16;fontCol