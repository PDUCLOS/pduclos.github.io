<mxfile host="app.diagrams.net" agent="tarifs" version="24.0.0"><diagram name="Vue d'ensemble"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="Direction Achats — Automatisation des données achats" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="30" as="geometry"/></mxCell><mxCell id="a2" value="Le moteur décide et trace, l'interface montre et fait agir. Aucune donnée ne quitte le poste ou le serveur interne." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#5B6B7A;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1200" height="20" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Sources&lt;/b&gt;&lt;br/&gt;• ERP de chaque entité (export ou API)&lt;br/&gt;• Tarifs fournisseurs (xlsx, csv, pdf)&lt;br/&gt;• Power BI — jeux de données&lt;br/&gt;• Snowflake — entrepôt groupe&lt;br/&gt;• BCE — taux de change datés&lt;br/&gt;• Ventes et volumes d'achat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1F7;strokeColor=#2C6E9B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="250" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Ingestion&lt;/b&gt;&lt;br/&gt;• Lecture intégrale, rien n'est jeté&lt;br/&gt;• Nettoyage des valeurs abîmées&lt;br/&gt;• Gabarit et correspondance des colonnes&lt;br/&gt;• Clé unique du tarif&lt;br/&gt;• Compte rendu préalable&lt;br/&gt;• Onboarding d'un fournisseur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#26333F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="230" height="250" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Normalisation&lt;/b&gt;&lt;br/&gt;• Devise au taux de la date&lt;br/&gt;• Unités et dimensions&lt;br/&gt;• Base de prix, prix comparables&lt;br/&gt;• Masque de référence&lt;br/&gt;• Transformations tracées&lt;br/&gt;• Quarantaine si irréconciliable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#26333F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="230" height="250" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;Référentiel&lt;/b&gt;&lt;br/&gt;• Rattachement en 5 niveaux&lt;br/&gt;• Arbitrage humain si ambiguïté&lt;br/&gt;• Liens versionnés, jamais effacés&lt;br/&gt;• Références fournisseur&lt;br/&gt;• Opérations annulables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#26333F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="230" height="250" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;Entrepôt DuckDB&lt;/b&gt;&lt;br/&gt;• 68 tables de faits et de versions&lt;br/&gt;• 42 vues ui_* — contrat d'interface&lt;br/&gt;• Fichier unique, sauvegardable&lt;br/&gt;• Écriture sérialisée&lt;br/&gt;• Journal de toutes les opérations" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#FBF3E2;strokeColor=#B8860B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="240" height="250" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;Poste de travail R / Shiny&lt;/b&gt;&lt;br/&gt;• Portefeuille, dossier, arbitrage&lt;br/&gt;• Analyse des variations&lt;br/&gt;• Remises et familles&lt;br/&gt;• Unités et dimensions&lt;br/&gt;• Prix spéciaux, ventes, économies&lt;br/&gt;• Pilotage et administration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3EC;strokeColor=#1A7F4B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="110" width="214" height="250" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b&gt;Règles métier et analyses&lt;/b&gt;&lt;br/&gt;• Variations N-1 / N pondérées par les volumes, impact annualisé, dispersion, meilleur prix&lt;br/&gt;• Remises par famille ou par article — effet tarif contre effet remise&lt;br/&gt;• Prix spéciaux : engagements, plafond de hausse opposable, volumes promis contre réalisés&lt;br/&gt;• Ventes et marchés : décrochages, clients perdus, références en extinction&lt;br/&gt;• Économies constatées et prix spéciaux pratiqués mais non déclarés&lt;br/&gt;• Historique des prix d'achat ERP et retard d'application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#26333F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="300" y="420" width="750" height="190" as="geometry"/></mxCell><mxCell id="a10" value="&lt;b&gt;Archive et configuration&lt;/b&gt;&lt;br/&gt;• Fichiers reçus, horodatés&lt;br/&gt;• config/ versionnée (YAML, JSON)&lt;br/&gt;• Secrets hors base (trousseau)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#FBF3E2;strokeColor=#B8860B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1110" y="420" width="240" height="150" as="geometry"/></mxCell><mxCell id="a11" value="&lt;b&gt;Livrables&lt;/b&gt;&lt;br/&gt;• Classeur d'analyse&lt;br/&gt;• Mémo de négociation&lt;br/&gt;• Compte rendu préalable&lt;br/&gt;• Extractions filtrées par profil&lt;br/&gt;• Lot de mise à jour ERP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3EC;strokeColor=#1A7F4B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="420" width="214" height="150" as="geometry"/></mxCell><mxCell id="a12" value="&lt;b&gt;Projet 2 — Scorecards fournisseurs&lt;/b&gt;&lt;br/&gt;• Une requête DAX versionnée par campagne · contrôles avant diffusion · note RSE datée&lt;br/&gt;• Génération au gabarit gelé, export PDF, board consolidé régénéré&lt;br/&gt;• Campagnes idempotentes : une relance ne crée ni doublon ni écrasement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3EC;strokeColor=#1A7F4B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="470" height="150" as="geometry"/></mxCell><mxCell id="a13" value="&lt;b&gt;Contrôle d'accès et traçabilité&lt;/b&gt;&lt;br/&gt;• Authentification par compte : empreintes bcrypt, limitation des tentatives, expiration de session&lt;br/&gt;• 5 profils — acheteur, référent données, direction, data architecte, administrateur&lt;br/&gt;• Droit d'agir vérifié côté moteur, jamais par l'affichage ; extractions filtrées et plafonnées&lt;br/&gt;• Toute écriture est versionnée, journalisée et annulable par son opération" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBECEA;strokeColor=#B3261E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="560" y="640" width="1054" height="150" as="geometry"/></mxCell><mxCell id="a14" value="dépôt / extraction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a17" value="écrit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a18" value="lecture seule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="a4" target="a9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="a5" target="a9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="a9" target="a7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="465"/><mxPoint x="1080" y="335"/></Array></mxGeometry></mxCell><mxCell id="a22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="534"/><mxPoint x="1080" y="495"/></Array></mxGeometry></mxCell><mxCell id="a23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="a9" target="a11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1375" y="591"/><mxPoint x="1375" y="495"/></Array></mxGeometry></mxCell><mxCell id="a24" value="commandes JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;dashed=1;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1507" y="390"/><mxPoint x="938" y="390"/></Array></mxGeometry></mxCell><mxCell id="a25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;dashed=1;" edge="1" parent="1" source="a3" target="a12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="640"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Pipeline et stockage"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="Pipeline de données — technologies, formats et persistance" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="30" as="geometry"/></mxCell><mxCell id="b2" value="Chaque étape conserve la valeur d'origine : rien n'est écrasé, tout est rejouable et traçable jusqu'à la cellule source." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#5B6B7A;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1300" height="20" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;1. Réception&lt;/b&gt;&lt;br/&gt;• Excel (openpyxl), CSV, PDF&lt;br/&gt;• Connecteurs ERP configurés&lt;br/&gt;• Power BI (MSAL), Snowflake (clé RSA)&lt;br/&gt;• Empreinte SHA du fichier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1F7;strokeColor=#2C6E9B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="238" height="150" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;2. Lecture brute&lt;/b&gt;&lt;br/&gt;• Toutes les cellules conservées&lt;br/&gt;• Ligne et colonne d'origine&lt;br/&gt;• Encodage et séparateur détectés&lt;br/&gt;• Aucune valeur corrigée ici" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#26333F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="308" y="120" width="238" height="150" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;3. Correspondance&lt;/b&gt;&lt;br/&gt;• Gabarit versionné par fournisseur&lt;br/&gt;• Rôles de colonnes, alias 4 langues&lt;br/&gt;• Signature d'entête comparée&lt;br/&gt;• Proposition si structure modifiée" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#26333F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="576" y="120" width="238" height="150" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;4. Normalisation&lt;/b&gt;&lt;br/&gt;• Devise, base de prix, unité&lt;br/&gt;• Dimensions et prix comparables&lt;br/&gt;• Référence normalisée (masque)&lt;br/&gt;• Transformations tracées" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#26333F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="844" y="120" width="238" height="150" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;5. Rattachement&lt;/b&gt;&lt;br/&gt;• Lien référence ↔ article ERP&lt;br/&gt;• 5 niveaux de certitude&lt;br/&gt;• Arbitrage humain si ambiguïté&lt;br/&gt;• Lien versionné, jamais effacé" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#26333F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1112" y="120" width="238" height="150" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;6. Analyse&lt;/b&gt;&lt;br/&gt;• Variations et impact annualisé&lt;br/&gt;• Remises, familles, prix nets&lt;br/&gt;• Prix spéciaux et plafonds&lt;br/&gt;• Économies et détections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#26333F;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1380" y="120" width="238" height="150" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;Technologies&lt;/b&gt;&lt;br/&gt;• Python 3.13 — moteur&lt;br/&gt;• DuckDB — base analytique fichier&lt;br/&gt;• pandas, pyarrow — calcul&lt;br/&gt;• rapidfuzz — rapprochement&lt;br/&gt;• R 4.6 / Shiny, reactable, echarts4r&lt;br/&gt;• Aucun service réseau requis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B4B4B4;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5B6B7A;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="238" height="190" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;DuckDB — données de travail&lt;/b&gt;&lt;br/&gt;• ligne_brute — la cellule telle que reçue&lt;br/&gt;• ligne_normalisee — valeurs comparables&lt;br/&gt;• variation, indicateur_famille&lt;br/&gt;• remise, prix_special (versionnés)&lt;br/&gt;• prix_erp, volume_achat, vente_erp&lt;br/&gt;• historique des prix d'achat" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#FBF3E2;strokeColor=#B8860B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="308" y="360" width="300" height="190" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;DuckDB — référentiel et traces&lt;/b&gt;&lt;br/&gt;• reference_maitre, lien_reference&lt;br/&gt;• gabarit_fichier, masque_fournisseur&lt;br/&gt;• operation — tout est annulable&lt;br/&gt;• journal — qui, quoi, quand&lt;br/&gt;• 42 vues ui_* — contrat d'interface" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#FBF3E2;strokeColor=#B8860B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="644" y="360" width="300" height="190" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;Fichiers&lt;/b&gt;&lt;br/&gt;• archive/ — fichiers reçus horodatés&lt;br/&gt;• config/ — YAML et JSON versionnés&lt;br/&gt;• sorties/ — classeurs, mémos, PDF&lt;br/&gt;• Secrets : trousseau ou variables d'environnement" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#FBF3E2;strokeColor=#B8860B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="980" y="360" width="300" height="190" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;Restitution&lt;/b&gt;&lt;br/&gt;• Interface R/Shiny — lecture seule des vues ui_*&lt;br/&gt;• Écritures par commandes JSON du moteur&lt;br/&gt;• Classeur d'analyse et mémo de négociation&lt;br/&gt;• Extractions filtrées et plafonnées par profil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3EC;strokeColor=#1A7F4B;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1316" y="360" width="298" height="190" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;Pourquoi DuckDB plutôt qu'un serveur de base de données&lt;/b&gt;&lt;br/&gt;• Le besoin est analytique, pas transactionnel : quelques milliers de lignes par dépôt, lues en masse, jamais en concurrence.&lt;br/&gt;• Un fichier unique se sauvegarde, se copie et se rejoue à l'identique : la recette d'une campagne est reproductible.&lt;br/&gt;• Aucune infrastructure à demander à la DSI pour démarrer ; le SQL reste standard, la bascule vers PostgreSQL est possible.&lt;br/&gt;• Contrainte assumée : une seule écriture à la fois (verrou de fichier) — les écritures de l'interface sont donc sérialisées." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B4B4B4;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5B6B7A;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1574" height="130" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;Rétention, reprise et preuve&lt;/b&gt;&lt;br/&gt;• Rien n'est supprimé physiquement : une suppression est un statut, une correction est une nouvelle version.&lt;br/&gt;• Chaque campagne est idempotente : la relancer ne crée ni doublon ni écrasement silencieux.&lt;br/&gt;• Toute donnée affichée remonte à sa source : fichier, onglet, ligne, colonne, valeur brute.&lt;br/&gt;• Les extractions retirent physiquement les colonnes interdites au profil et portent un en-tête de traçabilité." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B4B4B4;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5B6B7A;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1574" height="130" as="geometry"/></mxCell><mxCell id="b16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b21" value="conserve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b4" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b6" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b7" target="b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b8" target="b11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1417" y="310"/><mxPoint x="719" y="310"/></Array></mxGeometry></mxCell><mxCell id="b25" value="archive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b3" target="b12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="159" y="320"/><mxPoint x="1070" y="320"/></Array></mxGeometry></mxCell><mxCell id="b26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5B6B7A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;fontColor=#26333F;labelBackgroundColor=#FFFFFF;verticalAlign=middle;" edge="1" parent="1" source="b11" target="b13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="794" y="578"/><mxPoint x="1465" y="578"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>