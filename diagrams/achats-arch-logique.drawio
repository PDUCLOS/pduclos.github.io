    </mxCell>
    <mxCell id="note_2" value="&lt;b&gt;Modification en masse des options&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;l'administrateur seul ; le profil de l'appelant est exigé ; tout ou rien&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;options_profil.PROFIL_ADMIN&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1007" y="1142" width="464.5" height="78" as="geometry" />
    </mxCell>
    <mxCell id="note_3" value="&lt;b&gt;Écrire dans l'outil&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;seuls les profils qui peuvent décider ; la consultation seule est refusée avant tout appel&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;R/moteur.R · resoudre_auteur&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
