    <mxCell id="prof_admin" value="&lt;b&gt;Administrateur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Décider : oui&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Prix de vente, marges, clients : oui&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Prix d'achat : oui · éléments techniques : oui&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Export : 100 000 lignes au plus · accueil : Entités, ERP et taux&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Crée des comptes : acheteur, appro, referent, responsable, direction, finance, architecte, admin&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;admin&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#D9731A;strokeWidth=1.5;fillColor=#FFE6CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
