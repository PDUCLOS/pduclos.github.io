    <mxCell id="l_fichiers" value="&lt;b&gt;1. Fichiers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#26333F&quot;&gt;Tarifs fournisseurs (xlsx, xls, csv), exports et services des ERP, taux de change, configuration en YAML&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6B7A&quot;&gt;données réelles jamais versionnées&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#5B6B7A;strokeWidth=1.5;fillColor=#F5F3EE;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="100" y="140" width="500" height="84" as="geometry" />
    </mxCell>
    <mxCell id="l_moteur" value="&lt;b&gt;2. Moteur Python déterministe&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#26333F&quot;&gt;Règles de calcul sans IA ; une commande par action : python -m tarifs &amp;lt;commande&amp;gt; --json&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6B7A&quot;&gt;seul à écrire dans l'entrepôt · traitement.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#3C6E9B;strokeWidth=2;fillColor=#E8EEF4;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="100" y="276" width="500" height="84" as="geometry" />
    </mxCell>
    <mxCell id="l_entrepot" value="&lt;b&gt;3. Entrepôt DuckDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#26333F&quot;&gt;120 tables : brut immuable, dérivé recalculable, tables en ajout seul, journal&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6B7A&quot;&gt;data/entrepot.duckdb · un seul écrivain à la fois&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#3C6E9B;strokeWidth=2;fillColor=#E8EEF4;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="100" y="412" width="500" height="84" as="geometry" />
    </mxCell>
    <mxCell id="l_vues" value="&lt;b&gt;4. Vues ui_* : le contrat versionné&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#26333F&quot;&gt;91 vues ; VERSION_CONTRAT = 1.68 ; on ajoute des colonnes, on n'en retire pas sans changer la version&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6B7A&quot;&gt;vues_ui.py · docs/CONTRAT_UI.md&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#3C6E9B;strokeWidth=2;fillColor=#E8EEF4;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="100" y="548" width="500" height="84" as="geometry" />
    </mxCell>
    <mxCell id="l_ui" value="&lt;b&gt;5. Interface R/Shiny&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#26333F&quot;&gt;Lit les vues ui_* en lecture seule ; chaque action passe par la commande du moteur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5B6B7A&quot;&gt;auteur et profil pris à la session · R/moteur.R&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#3C6E9B;strokeWidth=2;fillColor=#E8EEF4;align=left;verticalAlign=middle;" vertex="1" parent="1">
