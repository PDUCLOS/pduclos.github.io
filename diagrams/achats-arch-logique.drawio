    <mxCell id="prof_direction" value="&lt;b&gt;Direction Achats&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Décider : non, consultation seule&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Prix de vente, marges, clients : oui&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Prix d'achat : oui · éléments techniques : non&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Export : 5 000 lignes au plus · accueil : Pilotage&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;direction&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#5B6B7A;strokeWidth=1.5;fillColor=#F5F3EE;align=left;verticalAlign=middle;" vertex="1" parent="1">
