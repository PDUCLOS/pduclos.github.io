    <mxCell id="t_interdit" value="écriture directe : jamais" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="18" y="568" width="76" height="44" as="geometry" />
    </mxCell>
    <mxCell id="ecrire_0" value="&lt;b&gt;Ajout seul, versionné, annulable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Jamais de modification ni de suppression : une correction est une nouvelle version, annuler est une opération (EF-80)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;RG-17 · referentiel.py · lot_masse.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="800" y="190" width="350" height="94" as="geometry" />
    </mxCell>
    <mxCell id="ecrire_1" value="&lt;b&gt;Motif de 10 caractères au moins&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;pour chaque lot et chaque droit accordé ou retiré&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;lot_masse.MOTIF_MIN = 10&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="800" y="296" width="350" height="64" as="geometry" />
    </mxCell>
    <mxCell id="ecrire_2" value="&lt;b&gt;Auteur obligatoire&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;pris dans la session de l'interface, jamais deviné par le moteur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;R/moteur.R · resoudre_auteur&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="800" y="372" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="ecrire_3" value="&lt;b&gt;Refus avant écriture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;contrôle complet d'abord ; un lot passe en tout ou rien ; 500 lignes au plus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;lot_masse.PLAFOND_LIGNES = 500&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="800" y="462" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="ecrire_4" value="&lt;b&gt;SQL en paramètres liés&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;aucune valeur n'est collée dans une requête&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;lot_masse.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="800" y="552" width="350" height="64" as="geometry" />
    </mxCell>
    <mxCell id="calculer_0" value="&lt;b&gt;L'absence n'est jamais 0 (RG-01)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;une valeur illisible reste vide avec son motif ; un impact sans volume reste vide&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;nettoyage.py · analyse.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1190" y="190" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="calculer_1" value="&lt;b&gt;Valeur d'origine conservée (RG-03)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;le prix lu dans le tarif ne disparaît jamais derrière le prix normalisé&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;nettoyage.py · normalisation.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1190" y="280" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="calculer_2" value="&lt;b&gt;Le doute va à un humain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;un rattachement ambigu n'est jamais appliqué ; un lien proposé n'entre dans aucun calcul diffusé&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;rattachement.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1190" y="370" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="calculer_3" value="&lt;b&gt;Refuser plutôt que faux&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;HT contre TTC, ou arrondis différents : l'analyse est refusée avant tout calcul&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;traitement.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1190" y="460" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="calculer_4" value="&lt;b&gt;Brut séparé du dérivé&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;le dérivé se recalcule ; le brut ne change jamais&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;entrepot.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1190" y="550" width="350" height="64" as="geometry" />
    </mxCell>
    <mxCell id="autorite_0" value="&lt;b&gt;Le moteur reste l'autorité&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;l'interface lit et demande ; un assistant éventuel propose, le moteur contrôle, l'humain tranche&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;docs/PIPELINE_ASSISTANT_LLM.md&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1580" y="190" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="autorite_1" value="&lt;b&gt;Règles de profils fermées&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;listes dans options_profil.py, recopiées dans config.R (miroirs R) ; un test vérifie qu'elles concordent&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;PROFILS_SANS_COMMERCIAL · PROFILS_DROIT_EXPORT&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1580" y="280" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="autorite_2" value="&lt;b&gt;ERP en lecture seule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;le moteur n'écrit jamais dans un ERP ; toute requête autre qu'un SELECT est refusée&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;erp/&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1580" y="370" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="autorite_3" value="&lt;b&gt;Aucune notification hors de l'outil&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;ni courriel ni message ; un résumé hebdomadaire est conçu (B-02), non livré&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;docs/BACKLOG.md · B-02&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1580" y="460" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="autorite_4" value="&lt;b&gt;Données réelles jamais versionnées&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;le dépôt et la démonstration ne contiennent que des données inventées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;README.md · .gitignore&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="1580" y="550" width="350" height="78" as="geometry" />
    </mxCell>
    <mxCell id="prof_acheteur" value="&lt;b&gt;Acheteur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Décider : oui&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Prix de vente, marges, clients : non, sauf option de l'administrateur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Prix d'achat : oui · éléments techniques : non&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Export : 5 000 lignes au plus · accueil : Tableau de bord&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;Crée des comptes : appro&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;acheteur&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#D9731A;strokeWidth=1.5;fillColor=#FFE6CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
