    </mxCell>
    <mxCell id="note_0" value="&lt;b&gt;Droit commercial effectif&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;valeur du profil, OU option validée par l'administrateur (motif, auteur, annulable) ; jamais pour architecte ni finance&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;options_profil.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
     <mxGeometry x="50" y="1142" width="464.5" height="78" as="geometry" />
    </mxCell>
    <mxCell id="note_1" value="&lt;b&gt;Export du dossier de négociation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#26333F&quot;&gt;accordé aux seuls architecte, acheteur, responsable et administrateur ; le moteur refuse aussi, avec journal&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B7A&quot;&gt;PROFILS_DROIT_EXPORT&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#26333F;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;strokeColor=#B8860B;strokeWidth=1.5;fillColor=#FFF2CC;align=left;verticalAlign=middle;" vertex="1" parent="1">
